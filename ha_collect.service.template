# TODO: Replace <USER> and <PATH>

[Unit]
Description=Home Assistant entity data collection
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=<USER>
Group=<USER>
WorkingDirectory=<PATH>
EnvironmentFile=<PATH>/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=<PATH>/.venv/bin/python ha_collect.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target